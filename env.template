# Environment Configuration Template
# Copy this file to .env.local and fill in your values

# ===========================================
# Pinata IPFS Configuration
# ===========================================
# Get these from https://app.pinata.cloud/account/api-keys
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key_here
NEXT_PUBLIC_PINATA_SECRET_KEY=your_pinata_secret_key_here

# ===========================================
# Network Configuration
# ===========================================
# Supported networks: base, base-sepolia
NEXT_PUBLIC_NETWORK=base-sepolia

# ===========================================
# Registry Contract Addresses
# ===========================================
# Base Mainnet Registry (update with actual deployed address)
NEXT_PUBLIC_BASE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Base Sepolia Registry (update with actual deployed address)
NEXT_PUBLIC_BASE_SEPOLIA_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# ===========================================
# Application Configuration
# ===========================================
NEXT_PUBLIC_APP_NAME=Zora-chan
NEXT_PUBLIC_APP_DESCRIPTION=The Manga-Inspired Coin Creation & Community Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Development Configuration
# ===========================================
# Set to 'development' for local development
NODE_ENV=development

# Enable debug logging
NEXT_PUBLIC_DEBUG=false

# ===========================================
# Analytics (Optional)
# ===========================================
# Add your analytics tracking IDs here
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# ===========================================
# Error Tracking (Optional)
# ===========================================
# Add your error tracking service configuration
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
