    "outdated": "pnpm outdated",
    "update": "pnpm update",
    "clean": "rm -rf .next node_modules/.cache",
    "prebuild": "pnpm type-check && pnpm lint",
    "precommit": "pnpm lint:fix && pnpm format && pnpm type-check"
